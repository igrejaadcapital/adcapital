{
  "appId": "br.com.adcapitaligreja.sistema",
  "appName": "AD Capital",
  "webDir": "dist",
  "server": {
    "url": "https://sistema.adcapitaligreja.com.br",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowNavigation": [
      "https://sistema.adcapitaligreja.com.br",
      "https://adcapitaligreja.com.br",
      "https://www.adcapitaligreja.com.br",
      "https://cadastro.adcapitaligreja.com.br",
      "https://api.adcapitaligreja.com.br"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  }
}
