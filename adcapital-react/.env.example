# Copie para .env (não commitar credenciais reais)

# API Django — preferir /api/v1/ (legado /api/ ainda funciona no backend)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Build Android (npm run build:mobile) — use URL de produção:
# VITE_API_URL=https://api.adcapitaligreja.com.br/api/v1

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
