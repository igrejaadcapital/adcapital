# Copie para .env e preencha (nunca commite o .env real).

DEBUG=False
SECRET_KEY=gere-uma-chave-longa-aleatoria

# Supabase / PostgreSQL (produção e dev remoto)
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Cron-job.org — header X-Cron-Secret em /api/v1/verificar-aniversarios/ (ou /api/ legado)
CRON_SECRET=gere-outra-chave-longa-aleatoria

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail (opcional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Smoke tests (opcional — validar produção após deploy)
# SMOKE_API_BASE=https://api.adcapitaligreja.com.br/api/v1
# SMOKE_API_LEGACY_BASE=https://api.adcapitaligreja.com.br/api
# SMOKE_ADMIN_USER=cpf-do-admin-sem-pontos
# SMOKE_ADMIN_PASSWORD=senha-pastoral-para-teste

# Staging (Render adcapital-api-staging / adcapital-web-staging)
# DJANGO_ENV=staging
# VITE_API_URL=https://staging-api.adcapitaligreja.com.br/api/v1

# Sentry (opcional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production

# JWT cookies (Fase 6 — domínio compartilhado api + sistema)
# JWT_COOKIE_DOMAIN=.adcapitaligreja.com.br

# Alertas infraestrutura (Resend — ver docs/ALERTAS-INFRA.md)
# RESEND_API_KEY=re_...
# ALERTAS_EMAIL_PARA=igrejaadcapital@gmail.com
# ALERTAS_VENCIMENTOS=[{"servico":"Domínio","vencimento":"2027-05-21","dias_aviso":60}]
